#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.6.1"
    }
    defaultPrim = "tiangong3"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "tiangong3"
{
    over "Geometry"
    {
        over "pelvis"
        {
            over "hip_pitch_l_link"
            {
                over "hip_roll_l_link"
                {
                    over "hip_yaw_l_link"
                    {
                        over "knee_pitch_l_link"
                        {
                            over "ankle_pitch_l_link"
                            {
                                over "ankle_roll_l_link"
                                {
                                    over "ankle_roll_l_joint" (
                                        prepend apiSchemas = ["PhysxJointAPI"]
                                    )
                                    {
                                    }
                                }

                                over "ankle_pitch_l_joint" (
                                    prepend apiSchemas = ["PhysxJointAPI"]
                                )
                                {
                                }
                            }

                            over "knee_pitch_l_joint" (
