#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.6.1"
    }
    defaultPrim = "tiangong3"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "tiangong3"
{
    over "Geometry"
    {
        over "pelvis"
        {
            over "hip_pitch_l_link"
            {
                over "hip_roll_l_link"
                {
                    over "Sphere" (
                        prepend apiSchemas = ["MjcCollisionAPI"]
                    )
                    {
                        uniform double[] mjc:solref = [0.02, 1]
                    }

                    over "hip_yaw_l_link"
                    {
                        over "Cylinder" (
                            prepend apiSchemas = ["MjcCollisionAPI"]
                        )
                        {
                            uniform double[] mjc:solref = [0.02, 1]
                        }

                        over "knee_pitch_l_link"
                        {
                            over "Cylinder" (
                                prepend apiSchemas = ["MjcCollisionAPI"]
                            )
                            {
                                uniform double[] mjc:solref = [0.02, 1]
                            }

                            over "ankle_pitch_l_link"
                            {
                                over "ankle_roll_l_link"
                                {
                                    over "foot_left_front_outer" (
                                        prepend apiSchemas = ["MjcCollisionAPI"]
                                    )
                                    {
                                        uniform double[] mjc:solref = [0.02, 1]
                                    }

                                    over "foot_left_front_inner" (
                                        prepend apiSchemas = ["MjcCollisionAPI"]
                                    )
                                    {
                                        uniform double[] mjc:solref = [0.02, 1]
                                    }

                                    over "foot_left_strip_outer" (
                                        prepend apiSchemas = ["MjcCollisionAPI"]
                                    )
                                    {
                                        uniform double[] mjc:solref = [0.02, 1]
                                    }

                                    over "foot_left_strip_inner" (
                                        prepend apiSchemas = ["MjcCollisionAPI"]
                                    )
                                    {
                                        uniform double[] mjc:solref = [0.02, 1]
                                    }

                                    over "ankle_roll_l_joint" (
                                        delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                                        prepend apiSchemas = ["MjcJointAPI"]
                                    )
                                    {
                                        uniform double mjc:actuatorfrcrange:max = 55
                                        uniform double mjc:actuatorfrcrange:min = -55
                                    }
                                }

                                over "ankle_pitch_l_joint" (
                                    delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                                    prepend apiSchemas = ["MjcJointAPI"]
                                )
                                {
                                    uniform double mjc:actuatorfrcrange:max = 55
                                    uniform double mjc:actuatorfrcrange:min = -55
                                }
                            }

                            over "knee_pitch_l_joint" (
                                delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                                prepend apiSchemas = ["MjcJointAPI"]
                            )
                            {
                                uniform double mjc:actuatorfrcrange:max = 400
                                uniform double mjc:actuatorfrcrange:min = -400
                            }
                        }

                        over "hip_yaw_l_joint" (
                            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                            prepend apiSchemas = ["MjcJointAPI"]
                        )
                        {
                            uniform double mjc:actuatorfrcrange:max = 150
                            uniform double mjc:actuatorfrcrange:min = -150
                        }
                    }

                    over "hip_roll_l_joint" (
                        delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                        prepend apiSchemas = ["MjcJointAPI"]
                    )
                    {
                        uniform double mjc:actuatorfrcrange:max = 235
                        uniform double mjc:actuatorfrcrange:min = -235
                    }
                }

                over "hip_pitch_l_joint" (
                    delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                    prepend apiSchemas = ["MjcJointAPI"]
                )
                {
                    uniform double mjc:actuatorfrcrange:max = 235
                    uniform double mjc:actuatorfrcrange:min = -235
                }
            }

            over "hip_pitch_r_link"
            {
                over "hip_roll_r_link"
                {
                    over "Sphere" (
                        prepend apiSchemas = ["MjcCollisionAPI"]
                    )
                    {
                        uniform double[] mjc:solref = [0.02, 1]
                    }

                    over "hip_yaw_r_link"
                    {
                        over "Cylinder" (
                            prepend apiSchemas = ["MjcCollisionAPI"]
                        )
                        {
                            uniform double[] mjc:solref = [0.02, 1]
                        }

                        over "knee_pitch_r_link"
                        {
                            over "Cylinder" (
                                prepend apiSchemas = ["MjcCollisionAPI"]
                            )
                            {
                                uniform double[] mjc:solref = [0.02, 1]
                            }

                            over "ankle_pitch_r_link"
                            {
                                over "ankle_roll_r_link"
                                {
                                    over "foot_right_front_outer" (
                                        prepend apiSchemas = ["MjcCollisionAPI"]
                                    )
                                    {
                                        uniform double[] mjc:solref = [0.02, 1]
                                    }

                                    over "foot_right_front_inner" (
                                        prepend apiSchemas = ["MjcCollisionAPI"]
                                    )
                                    {
                                        uniform double[] mjc:solref = [0.02, 1]
                                    }

                                    over "foot_right_strip_outer" (
                                        prepend apiSchemas = ["MjcCollisionAPI"]
                                    )
                                    {
                                        uniform double[] mjc:solref = [0.02, 1]
                                    }

                                    over "foot_right_strip_inner" (
                                        prepend apiSchemas = ["MjcCollisionAPI"]
                                    )
                                    {
                                        uniform double[] mjc:solref = [0.02, 1]
                                    }

                                    over "ankle_roll_r_joint" (
                                        delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                                        prepend apiSchemas = ["MjcJointAPI"]
                                    )
                                    {
                                        uniform double mjc:actuatorfrcrange:max = 55
                                        uniform double mjc:actuatorfrcrange:min = -55
                                    }
                                }

                                over "ankle_pitch_r_joint" (
                                    delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                                    prepend apiSchemas = ["MjcJointAPI"]
                                )
                                {
                                    uniform double mjc:actuatorfrcrange:max = 55
                                    uniform double mjc:actuatorfrcrange:min = -55
                                }
                            }

                            over "knee_pitch_r_joint" (
                                delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                                prepend apiSchemas = ["MjcJointAPI"]
                            )
                            {
                                uniform double mjc:actuatorfrcrange:max = 400
                                uniform double mjc:actuatorfrcrange:min = -400
                            }
                        }

                        over "hip_yaw_r_joint" (
                            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                            prepend apiSchemas = ["MjcJointAPI"]
                        )
                        {
                            uniform double mjc:actuatorfrcrange:max = 150
                            uniform double mjc:actuatorfrcrange:min = -150
                        }
                    }

                    over "hip_roll_r_joint" (
                        delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                        prepend apiSchemas = ["MjcJointAPI"]
                    )
                    {
                        uniform double mjc:actuatorfrcrange:max = 235
                        uniform double mjc:actuatorfrcrange:min = -235
                    }
                }

                over "hip_pitch_r_joint" (
                    delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                    prepend apiSchemas = ["MjcJointAPI"]
                )
                {
                    uniform double mjc:actuatorfrcrange:max = 235
                    uniform double mjc:actuatorfrcrange:min = -235
                }
            }

            over "waist_yaw_link"
            {
                over "waist_roll_link"
                {
                    over "waist_pitch_link"
                    {
                        over "shoulder_pitch_l_link"
                        {
                            over "shoulder_roll_l_link"
                            {
                                over "shoulder_yaw_l_link"
                                {
                                    over "elbow_pitch_l_link"
                                    {
                                        over "Cylinder" (
                                            prepend apiSchemas = ["MjcCollisionAPI"]
                                        )
                                        {
                                            uniform double[] mjc:solref = [0.02, 1]
                                        }

                                        over "elbow_yaw_l_link"
                                        {
                                            over "wrist_pitch_l_link"
                                            {
                                                over "wrist_pitch_l_collision_1" (
                                                    prepend apiSchemas = ["MjcCollisionAPI"]
                                                )
                                                {
                                                    uniform double[] mjc:solref = [0.02, 1]
                                                }

                                                over "wrist_roll_l_link"
                                                {
                                                    over "wrist_roll_l_joint" (
                                                        delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                                                        prepend apiSchemas = ["MjcJointAPI"]
                                                    )
                                                    {
                                                        uniform double mjc:actuatorfrcrange:max = 40
                                                        uniform double mjc:actuatorfrcrange:min = -40
                                                    }
                                                }

                                                over "wrist_pitch_l_joint" (
                                                    delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                                                    prepend apiSchemas = ["MjcJointAPI"]
                                                )
                                                {
                                                    uniform double mjc:actuatorfrcrange:max = 40
                                                    uniform double mjc:actuatorfrcrange:min = -40
                                                }
                                            }

                                            over "elbow_yaw_l_joint" (
                                                delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                                                prepend apiSchemas = ["MjcJointAPI"]
                                            )
                                            {
                                                uniform double mjc:actuatorfrcrange:max = 40
                                                uniform double mjc:actuatorfrcrange:min = -40
                                            }
                                        }

                                        over "elbow_pitch_l_joint" (
                                            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                                            prepend apiSchemas = ["MjcJointAPI"]
                                        )
                                        {
                                            uniform double mjc:actuatorfrcrange:max = 50
                                            uniform double mjc:actuatorfrcrange:min = -50
                                        }
                                    }

                                    over "shoulder_yaw_l_joint" (
                                        delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                                        prepend apiSchemas = ["MjcJointAPI"]
                                    )
                                    {
                                        uniform double mjc:actuatorfrcrange:max = 50
                                        uniform double mjc:actuatorfrcrange:min = -50
                                    }
                                }

                                over "shoulder_roll_l_joint" (
                                    delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                                    prepend apiSchemas = ["MjcJointAPI"]
                                )
                                {
                                    uniform double mjc:actuatorfrcrange:max = 90
                                    uniform double mjc:actuatorfrcrange:min = -90
                                }
                            }

                            over "shoulder_pitch_l_joint" (
                                delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                                prepend apiSchemas = ["MjcJointAPI"]
                            )
                            {
                                uniform double mjc:actuatorfrcrange:max = 90
                                uniform double mjc:actuatorfrcrange:min = -90
                            }
                        }

                        over "shoulder_pitch_r_link"
                        {
                            over "shoulder_roll_r_link"
                            {
                                over "shoulder_yaw_r_link"
                                {
                                    over "elbow_pitch_r_link"
                                    {
                                        over "Cylinder" (
                                            prepend apiSchemas = ["MjcCollisionAPI"]
                                        )
                                        {
                                            uniform double[] mjc:solref = [0.02, 1]
                                        }

                                        over "elbow_yaw_r_link"
                                        {
                                            over "wrist_pitch_r_link"
                                            {
                                                over "Cylinder" (
                                                    prepend apiSchemas = ["MjcCollisionAPI"]
                                                )
                                                {
                                                    uniform double[] mjc:solref = [0.02, 1]
                                                }

                                                over "wrist_roll_r_link"
                                                {
                                                    over "wrist_roll_r_joint" (
                                                        delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                                                        prepend apiSchemas = ["MjcJointAPI"]
                                                    )
                                                    {
                                                        uniform double mjc:actuatorfrcrange:max = 40
                                                        uniform double mjc:actuatorfrcrange:min = -40
                                                    }
                                                }

                                                over "wrist_pitch_r_joint" (
                                                    delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                                                    prepend apiSchemas = ["MjcJointAPI"]
                                                )
                                                {
                                                    uniform double mjc:actuatorfrcrange:max = 40
                                                    uniform double mjc:actuatorfrcrange:min = -40
                                                }
                                            }

                                            over "elbow_yaw_r_joint" (
                                                delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                                                prepend apiSchemas = ["MjcJointAPI"]
                                            )
                                            {
                                                uniform double mjc:actuatorfrcrange:max = 40
                                                uniform double mjc:actuatorfrcrange:min = -40
                                            }
                                        }

                                        over "elbow_pitch_r_joint" (
                                            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                                            prepend apiSchemas = ["MjcJointAPI"]
                                        )
                                        {
                                            uniform double mjc:actuatorfrcrange:max = 50
                                            uniform double mjc:actuatorfrcrange:min = -50
                                        }
                                    }

                                    over "shoulder_yaw_r_joint" (
                                        delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                                        prepend apiSchemas = ["MjcJointAPI"]
                                    )
                                    {
                                        uniform double mjc:actuatorfrcrange:max = 50
                                        uniform double mjc:actuatorfrcrange:min = -50
                                    }
                                }

                                over "shoulder_roll_r_joint" (
                                    delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                                    prepend apiSchemas = ["MjcJointAPI"]
                                )
                                {
                                    uniform double mjc:actuatorfrcrange:max = 90
                                    uniform double mjc:actuatorfrcrange:min = -90
                                }
                            }

                            over "shoulder_pitch_r_joint" (
                                delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                                prepend apiSchemas = ["MjcJointAPI"]
                            )
                            {
                                uniform double mjc:actuatorfrcrange:max = 90
                                uniform double mjc:actuatorfrcrange:min = -90
                            }
                        }

                        over "waist_pitch_joint" (
                            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                            prepend apiSchemas = ["MjcJointAPI"]
                        )
                        {
                            uniform double mjc:actuatorfrcrange:max = 150
                            uniform double mjc:actuatorfrcrange:min = -150
                        }
                    }

                    over "waist_roll_joint" (
                        delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                        prepend apiSchemas = ["MjcJointAPI"]
                    )
                    {
                        uniform double mjc:actuatorfrcrange:max = 150
                        uniform double mjc:actuatorfrcrange:min = -150
                    }
                }

                over "waist_yaw_joint" (
                    delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                    prepend apiSchemas = ["MjcJointAPI"]
                )
                {
                    uniform double mjc:actuatorfrcrange:max = 91
                    uniform double mjc:actuatorfrcrange:min = -91
                }
            }
        }
    }
}

over "PhysicsScene" (
    prepend apiSchemas = ["MjcSceneAPI"]
)
{
    uniform token mjc:compiler:angle = "radian"
}

